# Python bytecode
__pycache__/
*.py[codz]
*$py.class

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/

# Tests, coverage, and static-analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# uv-managed local state
.venv/
.uv-cache/
.uv-python/
requirements-export.txt

# Local environment and secrets
.env
.env.*
!.env.example

# Editors and local tools
.idea/
.vscode/
.codemoss/
.cursor/
.gemini/
.vs/
*.sublime-workspace
*.sublime-project

# OS metadata and temporary files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.log
*.tmp
*.bak
*.swp
*.swo
*~
~$*
~*.tmp

# Local application state
.matplotlib/
.ultralytics/
/yolov8-deepsort/Ultralytics/

# Redundant upstream checkout; the project uses uv's locked PyPI easydict
/yolov8-deepsort/easydict/

# Generated inference and training output
/yolov8-deepsort/directory/
/yolov8-deepsort/result*.mp4
**/runs/

# P0 Data Governance: S1 raw sensitive, S2 derived feature data, S3 authorized evidence
/data/S1_raw_sensitive/*
!/data/S1_raw_sensitive/.gitkeep
/data/S2_derived_features/*
!/data/S2_derived_features/.gitkeep
/data/S3_authorized_evidence/*
!/data/S3_authorized_evidence/.gitkeep
# Participant identities and raw private consent records
*_identity_mapping.*
*_private_consent.*

# P1 Model Assets & Intermediate Formats
models/
*.task
*.onnx
*.engine
*.tflite
*.safetensors
*.ckpt
*.h5

# User Uploaded Dynamic Media & Telemetry Runtime Outputs
/reports/uploaded_demo/*
!/reports/uploaded_demo/.gitkeep
/reports/uploaded_demo/**
!/reports/uploaded_demo/
!/reports/uploaded_demo/.gitkeep

