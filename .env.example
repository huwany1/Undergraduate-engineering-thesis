# ==============================================================================
# 运动质量评估与智能检测系统 - 本地环境变量配置模板 (Environment Template)
# 说明: 复制本文件为 .env 并填入实际值。请切勿将带有真实密钥的 .env 提交到 Git 仓库！
# ==============================================================================

# [可选] DeepSeek 大模型 AI 教练配置 (DeepSeek LLM Coach API)
# 若留空，系统将自动以优雅降级模式运行（使用内置确定性专家建议规则库）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# [可选] Web 演示看板服务设置 (Web Demo Server Settings)
PORT=8000
HOST=127.0.0.1
